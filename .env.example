# Copy to .env and fill in. Everything here is free. .env is git-ignored.

# --- LLM (generation + RAGAS judge) -------------------------------------------
# Groq free tier: create a key at https://console.groq.com/keys (no card needed).
GROQ_API_KEY=

# Generator: answers questions from the retrieved label / plant text.
FURWISE_GEN_PROVIDER=groq
FURWISE_GEN_MODEL=qwen/qwen3.8-27b

# RAGAS faithfulness judge. Deliberately a different model family from the
# generator, so the judge is not grading its own writing style.
FURWISE_JUDGE_PROVIDER=groq
FURWISE_JUDGE_MODEL=openai/gpt-oss-120b

# --- Optional -------------------------------------------------------------------
# Google Gemini free tier (https://aistudio.google.com/apikey) to split the load:
# GEMINI_API_KEY=
# FURWISE_GEN_PROVIDER=gemini
# FURWISE_GEN_MODEL=gemini-2.5-flash-lite
#
# Fully offline (no key): install https://ollama.com and `ollama pull llama3.2`
# FURWISE_GEN_PROVIDER=ollama
# FURWISE_GEN_MODEL=llama3.2
